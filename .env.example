# ---- Supabase ----
# Project API URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe for the browser, RLS-gated)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER ONLY — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin access ----
# Comma-separated allowlist of admin emails (magic-link login)
ADMIN_EMAILS=skcksgml@gmail.com

# ---- Site ----
# Public base URL, used for the join QR code and magic-link redirects.
# Leave blank on Vercel to auto-detect from the request/VERCEL_URL.
NEXT_PUBLIC_SITE_URL=
