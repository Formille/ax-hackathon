# ---- Supabase ----
# Project API URL (e.g. https://xxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe for the browser, RLS-gated)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER ONLY — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Admin access ----
# Admin login passcode. Pick any strong secret. If unset, admin is disabled.
ADMIN_PASSCODE=

# ---- Site (optional) ----
# Public base URL used for the join QR code.
# Leave blank to auto-detect from the request / VERCEL_URL.
NEXT_PUBLIC_SITE_URL=
